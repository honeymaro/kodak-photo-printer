# Optional peer dependencies are the transports and the image pipeline. Each
# pulls in a native module, and @abandonware/noble in particular compiles
# bluetooth-hci-socket from source, which is slow and needs a full toolchain.
# Consumers install only the ones they use, so this repository does not pull
# them in automatically. sharp and usb are devDependencies and still install.
auto-install-peers=false

# Keep the store layout strict so an accidental undeclared import fails here
# rather than for a consumer.
strict-peer-dependencies=false
